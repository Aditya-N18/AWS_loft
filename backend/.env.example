# ClickHouse
CLICKHOUSE_HOST=CLICKHOUSE_HOST
CLICKHOUSE_USER=CLICKHOUSE_USER
CLICKHOUSE_PASSWORD=CLICKHOUSE_PASSWORD
CLICKHOUSE_DB=CLICKHOUSE_DB

# Airbyte
AIRBYTE_API_KEY=your-airbyte-key
AIRBYTE_CONNECTION_ID_REDDIT=conn-xxx
AIRBYTE_CONNECTION_ID_USAGE=conn-yyy

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Render
RENDER_API_KEY=rnd_xxx
RENDER_WORKFLOW_SLUG=ghost-churn-workflows

# Render local dev (set to true when running `render workflows dev`)
RENDER_USE_LOCAL_DEV=true
BACKEND_INTERNAL_URL=http://localhost:8000
# RENDER_LOCAL_DEV_URL=http://localhost:8120  # only needed if non-default port

# testmail.app — receive-only inbox; send TO this address via SMTP
# Get namespace + API key from https://testmail.app/console
TESTMAIL_API_KEY=your-testmail-api-key
TESTMAIL_NAMESPACE=your-namespace
TESTMAIL_TO_EMAIL=your-namespace.ghostchurn@inbox.testmail.app
TESTMAIL_FROM_EMAIL=ghost-churn-agent@yourdomain.com

# Outbound SMTP (delivers mail TO testmail inbox — not SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password

# Offer policy defaults (Senso removed — frontend passthrough fields used on approve)
MAX_DISCOUNT_PCT=20
DEFAULT_CONTACT_NAME=Sarah Chen
DEFAULT_CONTACT_EMAIL=demo@example.com
DEFAULT_RENEWAL_DAYS=23

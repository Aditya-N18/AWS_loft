{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost-churn.local/schemas/agent_output.schema.json",
  "title": "AgentResult",
  "description": "Output from Kenil's agent for Aarsh (Render workflow) and Aditya (OpenUI)",
  "type": "object",
  "required": ["status", "account_id", "account_name", "churn_score", "threshold", "evaluated_at"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["monitoring", "approval_required", "escalate", "blocked"]
    },
    "account_id": { "type": "string" },
    "account_name": { "type": "string" },
    "churn_score": { "type": "number" },
    "threshold": { "type": "number" },
    "market_summary": {
      "type": ["object", "null"],
      "properties": {
        "summary": { "type": "string" },
        "primary_risk": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "senso_profile": {
      "type": ["object", "null"],
      "properties": {
        "account_id": { "type": "string" },
        "account_name": { "type": "string" },
        "arr": { "type": "number" },
        "renewal_date": { "type": "string" },
        "days_to_renewal": { "type": "integer" },
        "key_contact_name": { "type": "string" },
        "key_contact_email": { "type": "string", "format": "email" },
        "use_case": { "type": "string" },
        "product_tier": { "type": "string" },
        "max_discount_pct": { "type": "number" },
        "feature_unlock_allowed": { "type": "string" },
        "senso_policy": { "type": "string" },
        "escalation_required": { "type": "boolean" },
        "do_not_contact": { "type": "boolean" }
      }
    },
    "offer": {
      "type": ["object", "null"],
      "properties": {
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "discount_pct": { "type": "number" },
        "feature_unlock": { "type": "string" },
        "contact_name": { "type": "string" },
        "contact_email": { "type": "string", "format": "email" },
        "discount_capped": { "type": "boolean" }
      }
    },
    "cited_report_path": { "type": ["string", "null"] },
    "langfuse_trace_id": { "type": ["string", "null"] },
    "langfuse_trace_url": { "type": ["string", "null"] },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "properties": {
        "ui_state": { "type": "integer", "minimum": 1, "maximum": 5 },
        "discount_capped": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
